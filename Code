// ==========================================
// MOCK DATA GENERATOR
// ==========================================
const GENERATE_MOCK_DATA = () => {
  const departments = ['Enterprise', 'SaaS', 'Professional Services', 'Consumer Hardware'];
  const regions = ['North America', 'Europe', 'Asia-Pacific', 'Latin America'];
  const channels = ['Direct Sales', 'Online Store', 'Channel Partners', 'Referrals'];
  
  const data = [];
  const startDate = new Date('2026-01-01');
  
  for (let i = 0; i < 150; i++) {
    const date = new Date(startDate);
    date.setDate(startDate.getDate() + Math.floor(Math.random() * 120)); // Spans 4 months
    
    const department = departments[Math.floor(Math.random() * departments.length)];
    const region = regions[Math.floor(Math.random() * regions.length)];
    const channel = channels[Math.floor(Math.random() * channels.length)];
    
    // Revenue generation with some deterministic variance
    let baseRevenue = 5000;
    if (department === 'Enterprise') baseRevenue = 15000;
    if (department === 'Professional Services') baseRevenue = 8000;
    if (region === 'North America') baseRevenue *= 1.2;
    
    const revenue = Math.round(baseRevenue * (0.6 + Math.random() * 0.8));
    const visitors = Math.round(revenue / (10 + Math.random() * 15));
    const conversions = Math.round(visitors * (0.02 + Math.random() * 0.08));
    const activeUsers = Math.round(visitors * (0.4 + Math.random() * 0.3));
    
    data.push({
      id: `TX-${1000 + i}`,
      date: date.toISOString().split('T')[0],
      department,
      region,
      channel,
      revenue,
      visitors,
      conversions,
      activeUsers,
      status: revenue > 12000 ? 'Excellent' : revenue > 6000 ? 'On Track' : 'Needs Attention'
    });
  }
  return data.sort((a, b) => new Date(b.date) - new Date(a.date));
};

